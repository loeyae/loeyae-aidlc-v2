{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["bin/**/*.ts", "core/**/*.ts", "harness/**/*.ts", "scripts/**/*.ts", "tests/test_current_execution.ts", "tests/test_current_distribution.ts", "tests/test_task_knowledge.ts"],
  "exclude": ["node_modules", "dist"]
}
