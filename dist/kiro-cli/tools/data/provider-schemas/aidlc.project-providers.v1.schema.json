{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loeyae:aidlc:schema:project-providers:1",
  "title": "AI-DLC Project Providers",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "specVersion", "providers"],
  "properties": {
    "apiVersion": { "const": "aidlc.project-providers/v1" },
    "specVersion": { "const": "1.0.0" },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[^\\u0000]+$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "stages", "capabilities"],
      "properties": {
        "modules": { "$ref": "#/$defs/stringList" },
        "units": { "$ref": "#/$defs/stringList" },
        "stages": { "$ref": "#/$defs/stringList" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "id", "source", "enabled", "config", "bindings", "trust"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/id" },
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["git", "ref"],
          "properties": {
            "git": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "subdir": { "$ref": "#/$defs/path" }
          }
        },
        "enabled": { "type": "boolean" },
        "config": { "type": "object" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "required_for_protected_gates"],
          "properties": {
            "mode": { "enum": ["untrusted-development", "signed-commit-or-tag", "allowlisted-commit"] },
            "required_for_protected_gates": { "type": "boolean" }
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
      "additionalProperties": { "type": "object" }
    }
  }
}
