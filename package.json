{
  "name": "loeyae-aidlc",
  "version": "2.0.0",
  "description": "Loeyae AI-DLC v2 — engine-driven workflow with multi-harness distribution",
  "author": "Loeyae Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loeyae-aidlc": "./bin/cli.ts"
  },
  "files": [
    "bin/",
    "core/",
    "harness/",
    "scripts/",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsx scripts/build.ts",
    "build:kiro-crew": "npx tsx scripts/build.ts --harness kiro-crew",
    "build:kiro-ide": "npx tsx scripts/build.ts --harness kiro-ide",
    "build:claude": "npx tsx scripts/build.ts --harness claude",
    "build:opencode": "npx tsx scripts/build.ts --harness opencode",
    "build:all": "npx tsx scripts/build.ts --all",
    "install-skill": "npx tsx bin/cli.ts install",
    "test": "npx tsx --test tests/",
    "compile-graph": "npx tsx core/tools/aidlc-graph.ts compile",
    "scope-table": "npx tsx core/tools/aidlc-utility.ts scope-table",
    "postinstall": "npx tsx core/tools/aidlc-graph.ts compile || true"
  },
  "dependencies": {
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loeyae/loeyae-aidlc-v2.git"
  }
}
