{
  "name": "loeyae-aidlc",
  "version": "5.0.6",
  "description": "Goal-directed AI-DLC methods with one execution contract and progressive disclosure",
  "author": "Loeyae Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loeyae-aidlc": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "core/",
    "harness/",
    "dist/",
    "README.md",
    "scripts/build.ts",
    "scripts/manifest-types.ts",
    "scripts/generate-methods.ts"
  ],
  "scripts": {
    "prepack": "node --import tsx scripts/build.ts --all",
    "build": "tsx scripts/build.ts",
    "build:all": "tsx scripts/build.ts --all",
    "build:claude": "tsx scripts/build.ts --harness claude",
    "build:codebuddy": "tsx scripts/build.ts --harness codebuddy",
    "build:codex": "tsx scripts/build.ts --harness codex",
    "build:deepseek": "tsx scripts/build.ts --harness deepseek",
    "build:kiro-cli": "tsx scripts/build.ts --harness kiro-cli",
    "build:kiro-crew": "tsx scripts/build.ts --harness kiro-crew",
    "build:kiro-ide": "tsx scripts/build.ts --harness kiro-ide",
    "build:opencode": "tsx scripts/build.ts --harness opencode",
    "build:qoder": "tsx scripts/build.ts --harness qoder",
    "build:zcode": "tsx scripts/build.ts --harness zcode",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-core.mjs",
    "test:install": "node scripts/run-python.mjs tests/test_installer_lifecycle.py",
    "test:package": "node scripts/test-package.mjs",
    "test:providers": "node scripts/test-providers.mjs",
    "install-skill": "tsx bin/cli.ts install"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "jszip": "3.10.1",
    "markdown-it": "15.0.3",
    "tsx": "^4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "22.10.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loeyae/loeyae-aidlc-v2.git"
  }
}
