{
  "name": "loeyae-aidlc",
  "version": "4.20.0",
  "description": "Loeyae AI-DLC — AWS-style lightweight workflow with multi-harness distribution",
  "author": "Loeyae Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loeyae-aidlc": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "core/",
    "harness/",
    "scripts/",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "test:module-facts": "tsx tests/test_module_facts.ts",
    "test:module-knowledge": "tsx tests/test_module_knowledge.ts",
    "test:tech-extraction": "tsx tests/test_tech_extraction.ts",
    "test:docx-provider": "tsx tests/test_docx_provider.ts",
    "test:docx-provider-fixture": "tsx tests/test_docx_provider_fixture.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:mars243": "tsx tests/test_mars243_stop.ts && tsx tests/test_mars243_sessions.ts && tsx tests/test_mars243_layout.ts && tsx tests/test_mars243_report.ts",
    "pretest": "npm run test:module-facts && npm run test:mars169 && npm run test:mcp-readonly && npm run test:context-source-boundary",
    "test:context-source": "tsx tests/test_context_source.ts",
    "test:design-resource": "tsx tests/test_design_resource.ts",
    "test:context-source-boundary": "tsx tests/test_context_source_boundary.ts",
    "test:mcp-readonly": "tsx tests/test_mcp_readonly.ts",
    "test:mars161-phase2": "npx --no-install tsx tests/test_mars161_execution_profile_phase2.ts",
    "test:mars161-phase3": "npx --no-install tsx tests/test_mars161_execution_profile_phase3.ts",
    "test:mars161-phase4": "npx --no-install tsx tests/test_mars161_execution_profile_phase4.ts",
    "test:mars161-phase5": "npx --no-install tsx tests/test_mars161_execution_profile_phase5.ts",
    "test:mars161-phase6": "npx --no-install tsx tests/test_mars161_execution_profile_phase6.ts",
    "build:kiro-crew": "tsx scripts/build.ts --harness kiro-crew",
    "build:kiro-ide": "tsx scripts/build.ts --harness kiro-ide",
    "build:kiro-cli": "tsx scripts/build.ts --harness kiro-cli",
    "build:claude": "tsx scripts/build.ts --harness claude",
    "build:opencode": "tsx scripts/build.ts --harness opencode",
    "build:codex": "tsx scripts/build.ts --harness codex",
    "build:codebuddy": "tsx scripts/build.ts --harness codebuddy",
    "build:qoder": "tsx scripts/build.ts --harness qoder",
    "build:zcode": "tsx scripts/build.ts --harness zcode",
    "build:all": "tsx scripts/build.ts --all",
    "install-skill": "tsx bin/cli.ts install",
    "test": "node scripts/test-core.mjs",
    "evidence": "tsx core/tools/aidlc-evidence.ts",
    "compile-graph": "tsx core/tools/aidlc-graph.ts compile",
    "scope-table": "tsx core/tools/aidlc-utility.ts scope-table",
    "test:mars168": "tsx tests/run_mars168.ts quality",
    "test:mars168-regression": "tsx tests/run_mars168.ts regression",
    "test:provider-mcp": "tsx tests/test_provider_mcp.ts && tsx tests/test_provider_mcp_apply.ts && tsx tests/test_provider_mcp_recovery_cli.ts",
    "test:mars169": "tsx tests/test_mars169_document_slices.ts",
    "test:provider-local": "node scripts/test-providers.mjs local",
    "test:provider-integration": "node scripts/test-providers.mjs integration",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.9.12",
    "html-validate": "10.4.0",
    "jszip": "3.10.1",
    "markdown-it": "15.0.1",
    "parse5": "8.0.0",
    "tsx": "^4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "22.10.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loeyae/loeyae-aidlc-v2.git"
  },
  "bundleDependencies": [
    "html-validate"
  ]
}
